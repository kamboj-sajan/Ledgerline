{"version":3,"term":{"cols":120,"rows":38},"timestamp":1794768189,"idle_time_limit":2.0,"command":"scripts/demo.sh","title":"Ledgerline demo","env":{"SHELL":"/bin/zsh"}}
[0.033, "o", "\r\n\u001b[1;36m# Ledgerline: a payments API and double-entry ledger in Go\u001b[0m\r\n"]
[1.209, "o", "\u001b[1;32m$\u001b[0m docker compose up -d --wait serve dispatch 2>/dev/null | tail -1\r\n"]
[5.130, "o", "\r\n\u001b[1;36m# A merchant and its API key (stored only as a SHA-256 hash)\u001b[0m\r\n"]
[2.724, "o", "KEY=sk_Utvz1WZd9…\r\n\r\n\u001b[1;36m# Create, authorize and capture a $25.00 payment; every POST carries an Idempotency-Key\u001b[0m\r\n"]
[1.286, "o", "created pay_H6UCXROWD35H3YWNM5V6GB2JE3\r\n\u001b[1;32m$\u001b[0m api -X POST localhost:8080/v1/payments/$PID/authorize -H 'Idempotency-Key: auth-1001' | jq -c '{status, amount_authorized}'\r\n"]
[0.765, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"authorized\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"amount_authorized\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m2500\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[0.001, "o", "\u001b[1;32m$\u001b[0m api -X POST localhost:8080/v1/payments/$PID/capture -H 'Idempotency-Key: cap-1001' | jq -c '{status, amount_captured, fee}'\r\n"]
[0.664, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"captured\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"amount_captured\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m2500\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"fee\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m103\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[0.001, "o", "\r\n\u001b[1;36m# Retrying the same request replays the stored response; it does not capture twice\u001b[0m\r\n"]
[1.208, "o", "\u001b[1;32m$\u001b[0m curl -si \"${H[@]}\" -X POST localhost:8080/v1/payments/$PID/capture -H 'Idempotency-Key: cap-1001' | grep -E '^HTTP|Idempotent-Replayed'\r\n"]
[0.653, "o", "HTTP/1.1 200 OK\r\r\nIdempotent-Replayed: true\r\r\n"]
[0.004, "o", "\r\n\u001b[1;36m# A new capture with a different key is refused by the state machine\u001b[0m\r\n"]
[1.212, "o", "\u001b[1;32m$\u001b[0m api -X POST localhost:8080/v1/payments/$PID/capture -H 'Idempotency-Key: cap-1002' | jq -c .error\r\n"]
[0.645, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"type\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"invalid_request_error\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"code\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"invalid_state_transition\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"message\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"cannot capture a payment that is captured (captured → captured is not allowed)\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[0.001, "o", "\r\n\u001b[1;36m# The double-entry postings: debits positive, credits negative, summing to zero\u001b[0m\r\n"]
[1.216, "o", "\u001b[1;32m$\u001b[0m api localhost:8080/v1/payments/$PID/ledger | jq -r '.data[].entries[] | \"\\(.amount)\\t\\(.account)\"'\r\n"]
[0.851, "o", "2500\tplatform/processor_receivable/USD\r\n-2397\tmch_CUSHL2JNLCTPUY3JFPK3NEL6M2/merchant_payable/USD\r\n-103\tplatform/fee_revenue/USD\r\n"]
[0.000, "o", "\r\n\u001b[1;36m# The audit checks every ledger invariant against the stored rows\u001b[0m\r\n"]
[1.211, "o", "\u001b[1;32m$\u001b[0m docker compose run --rm -T serve audit 2>/dev/null | tail -1\r\n"]
[3.263, "o", "AUDIT PASSED\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "\u001b[1;36m# 100 goroutines capturing one payment, 100 retrying one key, 50 racing refunds (race detector on)\u001b[0m\r\n"]
[1.208, "o", "\u001b[1;32m$\u001b[0m go test -race -count=1 -tags=integration -run 'TestConcurrency' -v ./test/integration/ 2>&1 | grep -E '^(--- |ok)'\r\n"]
[6.074, "o", "--- PASS: TestConcurrencyCaptureDifferentKeys (0.20s)\r\n"]
[0.204, "o", "--- PASS: TestConcurrencyCaptureSameKey (0.20s)\r\n"]
[0.271, "o", "--- PASS: TestConcurrencyOverRefund (0.27s)\r\n"]
[0.193, "o", "--- PASS: TestConcurrencyReplaysOfFinishedKey (0.19s)\r\n"]
[1.300, "o", "ok  \tgithub.com/kamboj-sajan/ledgerline/test/integration\t4.528s\r\n"]
[0.059, "o", "\r\n\u001b[1;36m# Chaos: SIGKILL the API, dispatcher and receiver at failpoints and at random, then check everything\u001b[0m\r\n"]
[1.209, "o", "\u001b[1;32m$\u001b[0m go test -tags chaos -count=1 -run TestChaos -v ./test/chaos/ 2>&1 | grep -E 'flows|^(--- |ok)' | sed -E 's/restarts.*client/… client/'\r\n"]
[16.864, "o", "    chaos_test.go:440: flows 200 in 8.755s; random SIGKILLs 18; failpoint SIGKILLs 82 map[api-after-commit:24 authorize-after-acquirer-call:5 dispatch-after-send:53]; … client retries 588; events 869; duplicate deliveries deduped by the receiver 239\r\n--- PASS: TestChaos (10.64s)\r\nok  \tgithub.com/kamboj-sajan/ledgerline/test/chaos\t13.708s\r\n"]
[0.001, "o", "\r\n\u001b[1;36m# Done. Everything above is in the README and docs/\u001b[0m\r\n"]
[1.212, "x", "0"]
